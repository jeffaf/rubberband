      "optional": true
    }
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ]
  },
  "keywords": [
    "openclaw",
    "plugin",
    "security",
    "rubberband",
    "exec"
  ],
  "license": "MIT",
  "author": "jeffaf"
