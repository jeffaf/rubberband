{
  "name": "@jeffaf/rubberband",
  "version": "1.2.0",
  "description": "RubberBand - static command pattern detection for OpenClaw exec pipeline",
  "type": "module",
  "main": "index.ts",
  "files": [
    "index.ts",
    "rubberband.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "vitest": "^3.0.0"
  },
  "peerDependencies": {
    "openclaw": "*"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "compat": {
      "pluginApi": ">=2026.3.28",
      "minGatewayVersion": "2026.3.28"
    },
    "build": {
      "openclawVersion": "2026.3.28",
      "pluginSdkVersion": "2026.3.28"
    }
  },
  "keywords": [
    "openclaw",
    "plugin",
    "security",
    "rubberband",
    "exec"
  ],
  "license": "MIT",
  "author": "jeffaf"
}