{
  "name": "@jeffaf/rubberband",
  "version": "1.1.0",
  "description": "RubberBand - static command pattern detection for OpenClaw exec pipeline",
  "type": "module",
  "main": "index.ts",
  "files": [
    "index.ts",
    "rubberband.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
